{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Recorder",
  "version": "1.0.0",
  "identifier": "com.screenrecorder.desktop",
  "build": {
    "frontendDist": "../index.html"
  },
  "app": {
    "windows": [
      {
        "title": "Screen Recorder",
        "width": 1120,
        "height": 740,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {},
      "nsis": {}
    }
  }
}
